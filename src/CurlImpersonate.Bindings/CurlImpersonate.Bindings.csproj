<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>CurlImpersonate.Bindings</PackageId>
    <Version>1.0.2</Version>
    <Authors>curl-impersonate-dotnet contributors</Authors>
    <Description>.NET bindings for curl-impersonate: browser TLS/HTTP2 fingerprint impersonation (JA3/JA4). Bundles win-x64 and linux-x64 native libraries.</Description>
    <PackageTags>curl;impersonate;tls;fingerprint;http;browser</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Glob the staged native artifacts so the wrapper, the upstream curl-impersonate library and
       any of its sibling runtime dependencies (e.g. zlib.dll on Windows) are all packed and copied
       (transitively) into consuming output dirs. Staged by build-*.ps1 + fetch-upstream.ps1. -->
  <ItemGroup>
    <None Include="runtimes/win-x64/native/*.dll"
          Condition="Exists('runtimes/win-x64/native/cidn_wrapper.dll')">
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x64/native/%(Filename)%(Extension)</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes/linux-x64/native/*.so*"
          Condition="Exists('runtimes/linux-x64/native/libcidn_wrapper.so')">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native/%(Filename)%(Extension)</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
